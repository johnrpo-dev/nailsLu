# Servicio del API. Copiar a /etc/systemd/system/nailslu-api.service
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nailslu-api

[Unit]
Description=NAILS LU SPA - API
After=network.target

[Service]
Type=simple
User=nailslu
WorkingDirectory=/srv/nailslu/apps/api
Environment=NODE_ENV=production
EnvironmentFile=/srv/nailslu/apps/api/.env
ExecStart=/usr/bin/node dist/src/main.js

# Si el proceso muere, systemd lo revive. Sin esto un error puntual deja el
# negocio sin reservas hasta que alguien lo note.
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# `ProtectSystem=strict` deja el disco en solo lectura salvo lo que se liste
# aqui. Hacen falta tres sitios: la base, las fotos de los servicios que sube
# la duena y la carpeta de copias. Sin `uploads` el panel da error al subir una
# foto, y no de forma evidente: falla al escribir, no al validar.
ReadWritePaths=/srv/nailslu/apps/api/prisma /srv/nailslu/apps/api/uploads /srv/nailslu/backups

[Install]
WantedBy=multi-user.target
