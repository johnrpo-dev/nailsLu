# --- Base de datos -----------------------------------------------------------
# Ruta relativa al directorio desde el que arranca el API (apps/api). Desde
# Prisma 7 la resuelve el adaptador contra el directorio de trabajo, no contra
# la carpeta del esquema. Tambien acepta una ruta absoluta.
DATABASE_URL="file:./prisma/dev.db"

# --- Seguridad ---------------------------------------------------------------
# Sella los tokens de sesion del panel. Quien lo conozca puede fabricarse uno y
# entrar sin contrasena. Generar uno propio con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# En produccion el API se niega a arrancar si falta, si es demasiado corto o si
# conserva el valor de ejemplo.
JWT_ACCESS_SECRET="change-me-access"

# Duracion de la sesion del panel. No hay refresh tokens: al vencer hay que
# volver a entrar.
JWT_ACCESS_TTL="12h"

# --- Red ---------------------------------------------------------------------
PORT="3001"

# Dominios autorizados a llamar al API, separados por coma. En produccion es
# obligatorio; sin definir, acepta cualquier origen.
# WEB_ORIGIN="https://nailslu.com,https://www.nailslu.com"

# Numero de proxies inversos delante del API (1 con Caddy o nginx). Necesario
# para que el rate limiting vea la IP real de cada clienta. Dejar sin definir
# si el API se expone directamente.
# TRUST_PROXY="1"

# Zona horaria del salon. Decide que franjas se consideran pasadas: las horas
# se guardan como texto en hora local, asi que un servidor en UTC creeria que
# la jornada ya termino a las siete de la tarde de Colombia.
# SALON_TIMEZONE="America/Bogota"

# --- Rate limiting del formulario publico ------------------------------------
PUBLIC_BOOKING_RATE_LIMIT_TTL_SECONDS="60"
PUBLIC_BOOKING_RATE_LIMIT_MAX="5"

# Carpeta de fotos de servicios. Debe estar en disco persistente.
# UPLOADS_DIR="./uploads"

# Carpeta donde `npm run db:backup` deja las copias. Debe estar en disco
# persistente y, si se puede, en otro volumen distinto al de la base.
# BACKUP_DIR="./backups"

# --- Datos iniciales (solo los lee el seed) ----------------------------------
# Contrasena inicial del panel. Si se omite, el seed genera una al azar y la
# muestra una sola vez. Nunca se escribe en el codigo.
# SEED_ADMIN_PASSWORD=""
# SEED_ADMIN_EMAIL="admin@spa.local"

# Nombre con el que saluda el panel: "Hola, Yeri".
# SEED_ADMIN_NAME="Yeri"
