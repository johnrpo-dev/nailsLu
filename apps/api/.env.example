# Ruta relativa al directorio desde el que arranca el API (apps/api).
# Desde Prisma 7 la resuelve el adaptador contra el directorio de trabajo,
# no contra la carpeta del esquema. Tambien acepta una ruta absoluta.
DATABASE_URL="file:./prisma/dev.db"
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
PUBLIC_BOOKING_RATE_LIMIT_TTL_SECONDS="60"
PUBLIC_BOOKING_RATE_LIMIT_MAX="5"
JWT_ACCESS_TTL="12h"
